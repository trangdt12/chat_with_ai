{
  "openapi": "3.1.0",
  "info": {
    "title": "Chat với tài liệu (CWD) API",
    "version": "1.0.0-draft",
    "description": "Interface View của Blueprint SDD-CWD-001 v0.2 và SAD-CWD-001 v0.2.1 §2.4. Chỉ truy cập qua mạng nội bộ/VPN (CON-007). Lỗi theo RFC 9457 (application/problem+json). Mọi request thay đổi dữ liệu cần header X-CSRF-Token. Sự kiện SSE mô tả trong phần mở rộng x-sse-events (schema ở SAD Phụ lục A)."
  },
  "servers": [
    { "url": "https://cwd.congty.internal/api/v1", "description": "prod (tên miền nội bộ, SAD-OQ-04)" },
    { "url": "https://cwd-staging.congty.internal/api/v1", "description": "staging" }
  ],
  "security": [ { "cookieAuth": [] } ],
  "tags": [
    { "name": "auth", "description": "UC-18" },
    { "name": "documents", "description": "UC-01..06" },
    { "name": "qa", "description": "UC-07..17" },
    { "name": "admin", "description": "UC-19..21 (chỉ Quản trị viên CNTT)" },
    { "name": "ops", "description": "Vận hành" }
  ],
  "paths": {
    "/auth/login": {
      "get": {
        "tags": ["auth"], "operationId": "startLogin", "security": [],
        "summary": "Bắt đầu đăng nhập OIDC (Authorization Code + PKCE) với Entra ID",
        "responses": { "302": { "description": "Chuyển tới Entra ID authorize endpoint", "headers": { "Location": { "schema": { "type": "string", "format": "uri" } } } } }
      }
    },
    "/auth/callback": {
      "get": {
        "tags": ["auth"], "operationId": "completeLogin", "security": [],
        "summary": "Nhận code từ Entra ID, tạo phiên",
        "parameters": [
          { "name": "code", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "state", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "302": { "description": "Về trang chủ; đặt cookie __Host-cwd_session (HttpOnly; Secure; SameSite=Strict; Path=/)", "headers": { "Set-Cookie": { "schema": { "type": "string" } } } },
          "400": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["auth"], "operationId": "logout", "security": [ { "cookieAuth": [], "csrfHeader": [] } ],
        "responses": { "204": { "description": "Đã thu hồi phiên" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/me": {
      "get": {
        "tags": ["auth"], "operationId": "getMe",
        "responses": {
          "200": { "description": "Người dùng hiện tại", "headers": { "X-CSRF-Token": { "description": "CSRF token cho phiên", "schema": { "type": "string" } } },
                   "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Me" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/doc-sets/{dsid}/documents": {
      "parameters": [ { "$ref": "#/components/parameters/dsid" } ],
      "get": {
        "tags": ["documents"], "operationId": "listDocuments", "summary": "UC-06; mới nhất trước",
        "parameters": [ { "$ref": "#/components/parameters/cursor" }, { "$ref": "#/components/parameters/limit" } ],
        "responses": {
          "200": { "description": "Danh sách tài liệu", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DocumentPage" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "tags": ["documents"], "operationId": "uploadDocument", "summary": "UC-01; một file PDF ≤ 20 MB",
        "security": [ { "cookieAuth": [], "csrfHeader": [] } ],
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": {
          "type": "object", "required": ["file"],
          "properties": { "file": { "type": "string", "contentMediaType": "application/pdf", "maxLength": 20971520 } } } } } },
        "responses": {
          "202": { "description": "Đã tiếp nhận; xử lý bất đồng bộ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UploadAccepted" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "description": "CLASSIFICATION_REQUIRED (UC-03) | DOC_SET_FULL (E-08)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "413": { "description": "FILE_TOO_LARGE (E-07)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "415": { "description": "NOT_PDF (E-03)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/doc-sets/{dsid}/documents:batch": {
      "parameters": [ { "$ref": "#/components/parameters/dsid" } ],
      "post": {
        "tags": ["documents"], "operationId": "uploadBatch", "summary": "UC-02; chỉ vai trò manager (OI-03)",
        "security": [ { "cookieAuth": [], "csrfHeader": [] } ],
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": {
          "type": "object", "required": ["files"],
          "properties": { "files": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string", "contentMediaType": "application/pdf" } } } } } } },
        "responses": {
          "207": { "description": "Kết quả từng file", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BatchResult" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "description": "CLASSIFICATION_REQUIRED", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/doc-sets/{dsid}/documents/events": {
      "parameters": [ { "$ref": "#/components/parameters/dsid" } ],
      "get": {
        "tags": ["documents"], "operationId": "streamDocumentStatus", "summary": "SSE trạng thái tài liệu (E-20, SAD A.3)",
        "parameters": [ { "name": "Last-Event-ID", "in": "header", "required": false, "schema": { "type": "string" } } ],
        "responses": {
          "200": { "description": "text/event-stream; gửi snapshot khi kết nối/kết nối lại, keep-alive 15 giây",
                   "content": { "text/event-stream": { "schema": { "type": "string" } } },
                   "x-sse-events": {
                     "document.status": { "$ref": "#/components/schemas/DocumentStatusEvent" },
                     "document.removed": { "$ref": "#/components/schemas/DocumentRemovedEvent" } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/doc-sets/{dsid}/classification-confirmations": {
      "parameters": [ { "$ref": "#/components/parameters/dsid" } ],
      "post": {
        "tags": ["documents"], "operationId": "confirmClassification", "summary": "UC-03, BRU-001; mỗi phiên một lần",
        "security": [ { "cookieAuth": [], "csrfHeader": [] } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClassificationConfirmationRequest" } } } },
        "responses": {
          "201": { "description": "Đã ghi nhận", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClassificationConfirmation" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/documents/{docId}/file": {
      "parameters": [ { "$ref": "#/components/parameters/docId" } ],
      "get": {
        "tags": ["documents"], "operationId": "openOriginal", "summary": "UC-14; presigned URL 60 giây",
        "parameters": [ { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 200 } } ],
        "responses": {
          "302": { "description": "Chuyển tới presigned URL S3 kèm #page=N", "headers": { "Location": { "schema": { "type": "string", "format": "uri" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "410": { "$ref": "#/components/responses/Gone" }
        }
      }
    },
    "/doc-sets/{dsid}/conversations": {
      "parameters": [ { "$ref": "#/components/parameters/dsid" } ],
      "post": {
        "tags": ["qa"], "operationId": "startConversation", "summary": "UC-16",
        "security": [ { "cookieAuth": [], "csrfHeader": [] } ],
        "responses": {
          "201": { "description": "Hội thoại mới", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Conversation" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/conversations/{cid}/messages": {
      "parameters": [ { "$ref": "#/components/parameters/cid" } ],
      "post": {
        "tags": ["qa"], "operationId": "askQuestion", "summary": "UC-07..12; stream câu trả lời qua SSE",
        "security": [ { "cookieAuth": [], "csrfHeader": [] } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AskRequest" } } } },
        "responses": {
          "200": { "description": "text/event-stream (SAD A.4)",
                   "headers": { "X-RateLimit-Limit": { "schema": { "type": "integer", "const": 30 } }, "X-RateLimit-Remaining": { "schema": { "type": "integer", "minimum": 0 } } },
                   "content": { "text/event-stream": { "schema": { "type": "string" } } },
                   "x-sse-events": {
                     "answer.started": { "$ref": "#/components/schemas/AnswerStarted" },
                     "answer.delta": { "$ref": "#/components/schemas/AnswerDelta" },
                     "answer.completed": { "$ref": "#/components/schemas/AnswerCompleted" },
                     "answer.stopped": { "$ref": "#/components/schemas/AnswerStopped" },
                     "answer.failed": { "$ref": "#/components/schemas/AnswerFailed" } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "description": "NO_READY_DOCUMENTS (E-01, E-02)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/messages/{mid}:stop": {
      "parameters": [ { "$ref": "#/components/parameters/mid" } ],
      "post": {
        "tags": ["qa"], "operationId": "stopAnswer", "summary": "UC-12; hủy trong ≤ 1 giây (DD-08)",
        "security": [ { "cookieAuth": [], "csrfHeader": [] } ],
        "responses": {
          "202": { "description": "Đã yêu cầu dừng; stream kết thúc bằng answer.stopped" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/citations/{citId}": {
      "parameters": [ { "$ref": "#/components/parameters/citId" } ],
      "get": {
        "tags": ["qa"], "operationId": "getCitation", "summary": "UC-13",
        "responses": {
          "200": { "description": "Đoạn văn nguồn", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CitationView" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "410": { "$ref": "#/components/responses/Gone" }
        }
      }
    },
    "/messages/{mid}/feedback": {
      "parameters": [ { "$ref": "#/components/parameters/mid" } ],
      "put": {
        "tags": ["qa"], "operationId": "submitFeedback", "summary": "UC-17; ghi đè đánh giá trước (AC-US015-2)",
        "security": [ { "cookieAuth": [], "csrfHeader": [] } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FeedbackRequest" } } } },
        "responses": {
          "200": { "description": "Đã lưu", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FeedbackRequest" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/events": {
      "post": {
        "tags": ["qa"], "operationId": "emitClientEvent", "summary": "Sự kiện phía client (EVT-010, EVT-012); props theo danh sách trắng",
        "security": [ { "cookieAuth": [], "csrfHeader": [] } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClientEvent" } } } },
        "responses": { "202": { "description": "Đã nhận" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "422": { "$ref": "#/components/responses/ValidationError" } }
      }
    },
    "/admin/doc-sets/{dsid}/members": {
      "parameters": [ { "$ref": "#/components/parameters/dsid" } ],
      "get": {
        "tags": ["admin"], "operationId": "listMembers", "summary": "UC-19",
        "responses": {
          "200": { "description": "Thành viên nhóm truy cập", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Member" } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "tags": ["admin"], "operationId": "addMember", "summary": "UC-19; tra tài khoản qua Microsoft Graph",
        "security": [ { "cookieAuth": [], "csrfHeader": [] } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddMemberRequest" } } } },
        "responses": {
          "201": { "description": "Đã thêm", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Member" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "description": "USER_NOT_IN_DIRECTORY (UC-19 E1)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": { "description": "ALREADY_MEMBER", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/admin/doc-sets/{dsid}/members/{uid}": {
      "parameters": [ { "$ref": "#/components/parameters/dsid" }, { "$ref": "#/components/parameters/uid" } ],
      "patch": {
        "tags": ["admin"], "operationId": "changeRole", "summary": "UC-19; gán/bỏ vai trò manager",
        "security": [ { "cookieAuth": [], "csrfHeader": [] } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangeRoleRequest" } } } },
        "responses": {
          "200": { "description": "Đã đổi", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Member" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["admin"], "operationId": "removeMember", "summary": "UC-19; có hiệu lực ở request kế tiếp (QAS-2)",
        "security": [ { "cookieAuth": [], "csrfHeader": [] } ],
        "responses": { "204": { "description": "Đã gỡ" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/admin/doc-sets/{dsid}/documents": {
      "parameters": [ { "$ref": "#/components/parameters/dsid" } ],
      "get": {
        "tags": ["admin"], "operationId": "listAdminDocuments", "summary": "UC-20; chỉ thông tin mô tả (BRU-007)",
        "parameters": [ { "name": "q", "in": "query", "required": false, "schema": { "type": "string", "maxLength": 255 } }, { "$ref": "#/components/parameters/cursor" }, { "$ref": "#/components/parameters/limit" } ],
        "responses": {
          "200": { "description": "Thông tin mô tả tài liệu", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminDocumentPage" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/admin/documents/{docId}": {
      "parameters": [ { "$ref": "#/components/parameters/docId" } ],
      "delete": {
        "tags": ["admin"], "operationId": "purgeDocument", "summary": "UC-20, BR-017; ALG-07",
        "security": [ { "cookieAuth": [], "csrfHeader": [] } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PurgeRequest" } } } },
        "responses": {
          "202": { "description": "Đang gỡ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PurgeAccepted" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/admin/audit-logs": {
      "get": {
        "tags": ["admin"], "operationId": "queryAuditLog", "summary": "UC-21; tối đa 12 tháng (BRU-004)",
        "parameters": [
          { "$ref": "#/components/parameters/auditDocSet" }, { "$ref": "#/components/parameters/auditFrom" }, { "$ref": "#/components/parameters/auditTo" },
          { "$ref": "#/components/parameters/auditUser" }, { "$ref": "#/components/parameters/auditAction" },
          { "$ref": "#/components/parameters/cursor" }, { "$ref": "#/components/parameters/limit" }
        ],
        "responses": {
          "200": { "description": "Bản ghi nhật ký", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuditPage" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/admin/audit-logs:export": {
      "get": {
        "tags": ["admin"], "operationId": "exportAuditLog", "summary": "UC-21 A2; CSV UTF-8 BOM; lượt xuất được ghi nhật ký",
        "parameters": [
          { "$ref": "#/components/parameters/auditDocSet" }, { "$ref": "#/components/parameters/auditFrom" }, { "$ref": "#/components/parameters/auditTo" },
          { "$ref": "#/components/parameters/auditUser" }, { "$ref": "#/components/parameters/auditAction" }
        ],
        "responses": {
          "200": { "description": "Cột: ts, user_email, action, doc_set_id, document_id, filename", "content": { "text/csv": { "schema": { "type": "string" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/healthz": {
      "get": { "tags": ["ops"], "operationId": "liveness", "security": [], "responses": { "200": { "description": "Tiến trình còn sống", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } } } }
    },
    "/readyz": {
      "get": { "tags": ["ops"], "operationId": "readiness", "security": [],
        "responses": {
          "200": { "description": "Sẵn sàng (RDS, SQS kết nối được)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } },
          "503": { "description": "Chưa sẵn sàng", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": { "type": "apiKey", "in": "cookie", "name": "__Host-cwd_session", "description": "Phiên phía server, hết hạn sau 8 giờ không hoạt động (NFR-009)" },
      "csrfHeader": { "type": "apiKey", "in": "header", "name": "X-CSRF-Token", "description": "Lấy từ header X-CSRF-Token của GET /me" }
    },
    "parameters": {
      "dsid": { "name": "dsid", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "docId": { "name": "docId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "cid": { "name": "cid", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "mid": { "name": "mid", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "citId": { "name": "citId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "uid": { "name": "uid", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "cursor": { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } },
      "limit": { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 } },
      "auditDocSet": { "name": "doc_set_id", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "auditFrom": { "name": "from", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" } },
      "auditTo": { "name": "to", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" } },
      "auditUser": { "name": "user_id", "in": "query", "required": false, "schema": { "type": "string", "format": "uuid" } },
      "auditAction": { "name": "action", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/AuditAction" } }
    },
    "responses": {
      "Problem": { "description": "Lỗi", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Unauthorized": { "description": "UNAUTHENTICATED | SESSION_EXPIRED (E-18)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Forbidden": { "description": "FORBIDDEN (E-19); không tiết lộ tên tài liệu", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "NotFound": { "description": "NOT_FOUND", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Gone": { "description": "DOCUMENT_REMOVED (E-22)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "ValidationError": { "description": "VALIDATION_ERROR (E-14, E-15)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "RateLimited": {
        "description": "RATE_LIMITED | BUDGET_EXHAUSTED (E-13)",
        "headers": { "Retry-After": { "description": "Số giây tới đầu giờ kế tiếp (hoặc đầu tháng kế tiếp với BUDGET_EXHAUSTED)", "schema": { "type": "integer", "minimum": 1 } } },
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object", "required": ["type", "title", "status", "code", "request_id"],
        "properties": {
          "type": { "type": "string", "format": "uri" }, "title": { "type": "string" }, "status": { "type": "integer" },
          "detail": { "type": ["string", "null"] }, "request_id": { "type": "string" },
          "code": { "type": "string", "enum": [
            "UNAUTHENTICATED", "SESSION_EXPIRED", "FORBIDDEN", "NOT_FOUND", "VALIDATION_ERROR",
            "CLASSIFICATION_REQUIRED", "NOT_PDF", "FILE_TOO_LARGE", "DOC_SET_FULL", "NO_READY_DOCUMENTS",
            "RATE_LIMITED", "BUDGET_EXHAUSTED", "DOCUMENT_REMOVED", "USER_NOT_IN_DIRECTORY", "ALREADY_MEMBER", "INTERNAL" ] }
        }
      },
      "Role": { "type": "string", "enum": ["member", "manager"] },
      "Me": {
        "type": "object", "required": ["user_id", "display_name", "is_admin", "doc_sets"],
        "properties": {
          "user_id": { "type": "string", "format": "uuid" }, "display_name": { "type": "string" }, "is_admin": { "type": "boolean" },
          "doc_sets": { "type": "array", "items": { "type": "object", "required": ["id", "name", "role"],
            "properties": { "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" }, "role": { "$ref": "#/components/schemas/Role" },
                            "classification_confirmed": { "type": "boolean" } } } }
        }
      },
      "DocumentStatus": { "type": "string", "enum": ["uploaded", "processing", "ready", "failed", "purging", "purge_pending"] },
      "DocumentErrorCode": { "type": ["string", "null"], "enum": ["corrupt", "encrypted", "no_text", "too_many_pages", "timeout", null] },
      "Document": {
        "type": "object", "required": ["id", "filename", "size_bytes", "status", "progress", "uploaded_by", "uploaded_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" }, "filename": { "type": "string", "maxLength": 255 },
          "pages": { "type": ["integer", "null"], "minimum": 1, "maximum": 200 }, "size_bytes": { "type": "integer", "minimum": 1, "maximum": 20971520 },
          "status": { "$ref": "#/components/schemas/DocumentStatus" }, "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
          "error_code": { "$ref": "#/components/schemas/DocumentErrorCode" },
          "uploaded_by": { "type": "string" }, "uploaded_at": { "type": "string", "format": "date-time" }
        }
      },
      "DocumentPage": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Document" } }, "next_cursor": { "type": ["string", "null"] } } },
      "AdminDocument": {
        "description": "Chỉ thông tin mô tả (BRU-007) — không có nội dung, không có đoạn trích",
        "type": "object", "required": ["id", "filename", "size_bytes", "status", "uploaded_by", "uploaded_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" }, "filename": { "type": "string" }, "pages": { "type": ["integer", "null"] },
          "size_bytes": { "type": "integer" }, "status": { "$ref": "#/components/schemas/DocumentStatus" },
          "uploaded_by": { "type": "string" }, "uploaded_at": { "type": "string", "format": "date-time" }
        }
      },
      "AdminDocumentPage": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/AdminDocument" } }, "next_cursor": { "type": ["string", "null"] } } },
      "UploadAccepted": {
        "type": "object", "required": ["id", "filename", "status", "renamed"],
        "properties": { "id": { "type": "string", "format": "uuid" }, "filename": { "type": "string" }, "status": { "const": "uploaded" }, "renamed": { "type": "boolean", "description": "true nếu đã đổi thành 'ten (2).pdf' (E-09)" } }
      },
      "BatchResult": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/BatchItemResult" } } } },
      "BatchItemResult": {
        "type": "object", "required": ["filename"],
        "properties": { "filename": { "type": "string" }, "id": { "type": ["string", "null"], "format": "uuid" }, "renamed": { "type": "boolean" },
                        "error_code": { "type": ["string", "null"], "enum": ["NOT_PDF", "FILE_TOO_LARGE", "DOC_SET_FULL", null] } }
      },
      "ClassificationConfirmationRequest": { "type": "object", "required": ["statement_version"], "properties": { "statement_version": { "type": "integer", "minimum": 1 } } },
      "ClassificationConfirmation": { "type": "object", "required": ["confirmed_at"], "properties": { "confirmed_at": { "type": "string", "format": "date-time" } } },
      "DocumentStatusEvent": {
        "type": "object", "required": ["schema_version", "id", "filename", "status", "progress"],
        "properties": { "schema_version": { "const": 1 }, "id": { "type": "string", "format": "uuid" }, "filename": { "type": "string" },
                        "status": { "$ref": "#/components/schemas/DocumentStatus" }, "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
                        "error_code": { "$ref": "#/components/schemas/DocumentErrorCode" } }
      },
      "DocumentRemovedEvent": { "type": "object", "required": ["schema_version", "id"], "properties": { "schema_version": { "const": 1 }, "id": { "type": "string", "format": "uuid" } } },
      "Conversation": { "type": "object", "required": ["conversation_id"], "properties": { "conversation_id": { "type": "string", "format": "uuid" } } },
      "AskRequest": { "type": "object", "required": ["question"], "additionalProperties": false,
        "properties": { "question": { "type": "string", "minLength": 1, "maxLength": 2000, "description": "Bỏ khoảng trắng hai đầu trước khi kiểm tra (E-14, E-15)" } } },
      "CitationRef": {
        "type": "object", "required": ["idx", "citation_id", "document_id", "filename", "page"],
        "properties": { "idx": { "type": "integer", "minimum": 1 }, "citation_id": { "type": "string", "format": "uuid" },
                        "document_id": { "type": "string", "format": "uuid" }, "filename": { "type": "string" }, "page": { "type": "integer", "minimum": 1 } }
      },
      "AnswerStarted": { "type": "object", "required": ["schema_version", "message_id", "turn_index"],
        "properties": { "schema_version": { "const": 1 }, "message_id": { "type": "string", "format": "uuid" }, "turn_index": { "type": "integer", "minimum": 0 } } },
      "AnswerDelta": { "type": "object", "required": ["schema_version", "text", "citations"],
        "properties": { "schema_version": { "const": 1 }, "text": { "type": "string" }, "citations": { "type": "array", "items": { "$ref": "#/components/schemas/CitationRef" } } } },
      "AnswerCompleted": {
        "type": "object", "required": ["schema_version", "message_id", "status", "answer_type", "citations", "pending_documents", "latency"],
        "properties": {
          "schema_version": { "const": 1 }, "message_id": { "type": "string", "format": "uuid" }, "status": { "const": "completed" },
          "answer_type": { "type": "string", "enum": ["answered", "not_found", "clarification"] },
          "citations": { "type": "array", "items": { "$ref": "#/components/schemas/CitationRef" } },
          "pending_documents": { "type": "array", "description": "AC-US001-3", "items": { "type": "object", "required": ["id", "filename"],
            "properties": { "id": { "type": "string", "format": "uuid" }, "filename": { "type": "string" } } } },
          "latency": { "type": "object", "required": ["first_token_ms", "total_ms"],
            "properties": { "first_token_ms": { "type": ["integer", "null"] }, "total_ms": { "type": "integer" } } }
        }
      },
      "AnswerStopped": { "type": "object", "required": ["schema_version", "message_id", "status"],
        "properties": { "schema_version": { "const": 1 }, "message_id": { "type": "string", "format": "uuid" }, "status": { "const": "stopped" } } },
      "AnswerFailed": { "type": "object", "required": ["schema_version", "message_id", "status", "code", "retryable"],
        "properties": { "schema_version": { "const": 1 }, "message_id": { "type": "string", "format": "uuid" }, "status": { "const": "incomplete" },
                        "code": { "type": "string", "enum": ["AI_UNAVAILABLE", "AI_TIMEOUT", "AI_REFUSED", "MAX_TOKENS", "NETWORK", "INTERNAL"] },
                        "retryable": { "type": "boolean" } } },
      "CitationView": { "type": "object", "required": ["document_id", "filename", "page", "snippet"],
        "properties": { "document_id": { "type": "string", "format": "uuid" }, "filename": { "type": "string" },
                        "page": { "type": "integer", "minimum": 1 }, "snippet": { "type": "string", "maxLength": 300 } } },
      "FeedbackRequest": { "type": "object", "required": ["rating"], "additionalProperties": false,
        "properties": { "rating": { "type": "string", "enum": ["up", "down"] },
                        "reason": { "type": ["string", "null"], "enum": ["wrong", "incomplete", "wrong_source", "other", null] } } },
      "ClientEvent": {
        "type": "object", "required": ["name", "props"], "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "enum": ["citation_opened", "answer_copied"] },
          "props": { "type": "object", "additionalProperties": false,
            "properties": { "citation_index": { "type": "integer", "minimum": 1 }, "doc_id": { "type": "string", "format": "uuid" },
                            "target": { "type": "string", "enum": ["preview", "original"] }, "citation_count": { "type": "integer", "minimum": 0 },
                            "message_id": { "type": "string", "format": "uuid" } } }
        }
      },
      "Member": { "type": "object", "required": ["user_id", "email", "display_name", "role"],
        "properties": { "user_id": { "type": "string", "format": "uuid" }, "email": { "type": "string", "format": "email" },
                        "display_name": { "type": "string" }, "role": { "$ref": "#/components/schemas/Role" } } },
      "AddMemberRequest": { "type": "object", "required": ["email", "role"], "additionalProperties": false,
        "properties": { "email": { "type": "string", "format": "email" }, "role": { "$ref": "#/components/schemas/Role" } } },
      "ChangeRoleRequest": { "type": "object", "required": ["role"], "additionalProperties": false, "properties": { "role": { "$ref": "#/components/schemas/Role" } } },
      "PurgeRequest": { "type": "object", "required": ["reason", "requested_by"], "additionalProperties": false,
        "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500 }, "requested_by": { "type": "string", "format": "email" } } },
      "PurgeAccepted": { "type": "object", "required": ["purge_status"], "properties": { "purge_status": { "type": "string", "enum": ["purging", "purged", "purge_pending"] } } },
      "AuditAction": { "type": "string", "enum": [
        "login", "logout", "session_expired", "classification_confirm", "upload", "view_list", "view_citation", "view_file",
        "query", "remove_document", "member_add", "member_remove", "role_change", "audit_query", "audit_export", "access_denied" ] },
      "AuditEntry": {
        "description": "Không chứa nội dung tài liệu hay câu hỏi (BRU-004, G-13)",
        "type": "object", "required": ["ts", "action"],
        "properties": { "ts": { "type": "string", "format": "date-time" }, "user_id": { "type": ["string", "null"], "format": "uuid" },
                        "user_email": { "type": ["string", "null"] }, "action": { "$ref": "#/components/schemas/AuditAction" },
                        "doc_set_id": { "type": ["string", "null"], "format": "uuid" }, "document_id": { "type": ["string", "null"], "format": "uuid" },
                        "filename": { "type": ["string", "null"] } }
      },
      "AuditPage": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/AuditEntry" } }, "next_cursor": { "type": ["string", "null"] } } },
      "Health": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "enum": ["ok", "degraded", "down"] },
                  "checks": { "type": "object", "additionalProperties": { "type": "string" } } } }
    }
  }
}
